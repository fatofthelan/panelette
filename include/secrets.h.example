#ifndef SECRETS_H
#define SECRETS_H

// OPTIONAL. If you build from source and want to bake your Wi-Fi in,
// copy this file to secrets.h (which is gitignored) and fill in real
// values - they take priority over anything set on the device.
//
// You can also skip this entirely: the panel will come up in setup mode
// (its own Wi-Fi network / the browser installer) and store credentials
// on the device itself.
//
// Leaving the placeholder "your-wifi-ssid" here counts as "not set".
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

#endif // SECRETS_H
