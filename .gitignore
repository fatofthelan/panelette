# PlatformIO: build output, downloaded platforms/frameworks/libraries (all regenerated)
.pio

# VS Code: ignore everything PlatformIO / the C/C++ extension regenerates
# per-machine (absolute toolchain paths, IntelliSense caches, debug config).
# Only extensions.json is intentionally shared - it recommends the
# PlatformIO IDE extension to anyone who opens the folder.
.vscode/*
!.vscode/extensions.json

# macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows / Linux desktop cruft (harmless to keep for contributors)
Thumbs.db
Desktop.ini

# Editor scratch / merge leftovers
*~
*.swp
*.swo
*.orig
*.bak

# Local AI-assistant state / per-machine agent config (CLAUDE.md itself is
# tracked on purpose - it doubles as the contributor tech reference)
.claude/
.cursor/
.aider*

# Device WiFi credentials - keep the .example template tracked
include/secrets.h
!include/secrets.h.example
