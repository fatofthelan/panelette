# PlatformIO: build output, downloaded platforms/frameworks/libraries (all regenerated)
.pio

# VS Code files PlatformIO regenerates per-machine (keep .vscode/extensions.json tracked)
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# macOS
.DS_Store
**/.DS_Store
._*
.Spotlight-V100
.Trashes

# Windows / Linux desktop cruft (harmless to keep for contributors)
Thumbs.db
Desktop.ini

# Editor scratch / merge leftovers
*~
*.swp
*.swo
*.orig
*.bak

# Device WiFi credentials - keep the .example template tracked
include/secrets.h
!include/secrets.h.example
